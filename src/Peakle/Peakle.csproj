<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Peakle</AssemblyName>
    <RootNamespace>Peakle</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Machine-specific paths. Override in Peakle.user.props (not committed) if yours differ. -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\PEAK</GameDir>
    <ProfileDir>$(APPDATA)\Thunderstore Mod Manager\DataFolder\PEAK\profiles\Peakle Dev</ProfileDir>
  </PropertyGroup>

  <Import Project="Peakle.user.props" Condition="Exists('Peakle.user.props')" />

  <PropertyGroup>
    <ManagedDir>$(GameDir)\PEAK_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\logo.png" LogicalName="Peakle.Resources.logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zorro.ControllerSupport"><HintPath>$(ManagedDir)\Zorro.ControllerSupport.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zorro.Settings.Runtime"><HintPath>$(ManagedDir)\Zorro.Settings.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zorro.UI.Runtime"><HintPath>$(ManagedDir)\Zorro.UI.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zorro.Core.Runtime"><HintPath>$(ManagedDir)\Zorro.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonUnityNetworking"><HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PhotonRealtime"><HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Animation.Rigging"><HintPath>$(ManagedDir)\Unity.Animation.Rigging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(ProfileDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ProfileDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    After every build, install the mod into the Thunderstore dev profile the way the manager's "Import local mod" does,
    so it shows in the profile's mod list (name, icon, version). Restart the manager to see list changes.
    ModAuthor is the Thunderstore namespace (team name) the mod will be published under.
  -->
  <PropertyGroup>
    <ModAuthor>SlopGaming</ModAuthor>
    <PackageDir>$(MSBuildProjectDirectory)\..\..\package</PackageDir>
    <DeployScript>$(MSBuildProjectDirectory)\..\..\tools\deploy_local_mod.py</DeployScript>
  </PropertyGroup>
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)\BepInEx')">
    <Exec Command="python -I &quot;$(DeployScript)&quot; &quot;$(ProfileDir)&quot; &quot;$(TargetPath)&quot; &quot;$(PackageDir)&quot; &quot;$(MSBuildProjectDirectory)\Plugin.cs&quot; $(ModAuthor)" />
  </Target>

</Project>
